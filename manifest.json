{
  "manifest_version": 3,
  "name": "Are.na New Tab Curator",
  "version": "2.0.1",
  "description": "Replace new tab with a masonry of blocks from public Are.na channels.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.are.na/*",
    "https://images.are.na/*",
    "https://d2w9rnfcy7mm78.cloudfront.net/*"
  ]
}
